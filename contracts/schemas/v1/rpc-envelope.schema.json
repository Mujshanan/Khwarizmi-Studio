{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/rpc-envelope.schema.json",
  "title": "Khwarizmi JSON-RPC 2.0 Envelope v1",
  "oneOf": [
    {
      "$ref": "#/$defs/getInfoRequest"
    },
    {
      "$ref": "#/$defs/validateRequest"
    },
    {
      "$ref": "#/$defs/evaluateRequest"
    },
    {
      "$ref": "#/$defs/cancelNotification"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "getInfoRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "const": "host.getInfo"
        },
        "params": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "validateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "const": "document.validate"
        },
        "params": {
          "$ref": "rpc/document-validate.schema.json"
        }
      }
    },
    "evaluateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "const": "document.evaluate"
        },
        "params": {
          "$ref": "rpc/document-evaluate.schema.json"
        }
      }
    },
    "cancelNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "$/cancelRequest"
        },
        "params": {
          "$ref": "rpc/cancel-request.schema.json"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          },
          "properties": {
            "id": {
              "$ref": "#/$defs/errorId"
            }
          }
        }
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/errorId"
        },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    },
    "errorId": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
