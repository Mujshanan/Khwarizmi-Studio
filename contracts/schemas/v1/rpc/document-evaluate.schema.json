{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/rpc/document-evaluate.schema.json",
  "title": "document.evaluate Params v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "documentDigest",
    "semanticVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "document": {
      "$ref": "../calculation-document.schema.json"
    },
    "documentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semanticVersion": {
      "const": "1.0.0"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startAtStatementId": {
          "type": "string",
          "minLength": 1
        },
        "stopAfterStatementId": {
          "type": "string",
          "minLength": 1
        },
        "includeSubstitutionTrace": {
          "type": "boolean"
        }
      }
    }
  }
}
