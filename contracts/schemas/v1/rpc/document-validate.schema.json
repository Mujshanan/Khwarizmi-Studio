{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/rpc/document-validate.schema.json",
  "title": "document.validate Params v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "documentDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "document": {
      "$ref": "../calculation-document.schema.json"
    },
    "documentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
