{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/assignment.schema.json",
  "title": "Khwarizmi Assignment Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "statementId",
    "assignmentId",
    "targetSymbolId",
    "expression"
  ],
  "properties": {
    "kind": {
      "const": "assign"
    },
    "statementId": {
      "type": "string",
      "minLength": 1
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1
    },
    "targetSymbolId": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "$ref": "expression.schema.json"
    }
  }
}
