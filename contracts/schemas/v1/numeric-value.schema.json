{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/numeric-value.schema.json",
  "title": "Khwarizmi Scalar Value v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "decimal"
      ],
      "properties": {
        "kind": {
          "const": "exactDecimal"
        },
        "decimal": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "numerator",
        "denominator"
      ],
      "properties": {
        "kind": {
          "const": "exactRational"
        },
        "numerator": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "precision",
        "method"
      ],
      "properties": {
        "kind": {
          "const": "approximate"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
        },
        "precision": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "method": {
          "enum": [
            "compute-engine",
            "unit-conversion",
            "transcendental",
            "rounded-input"
          ]
        }
      }
    }
  ]
}
