{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/expression.schema.json",
  "title": "Khwarizmi Expression Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "mathJson",
    "symbolBindings",
    "authoredNumbers",
    "unitAttachments",
    "sourceMap"
  ],
  "properties": {
    "format": {
      "const": "khwarizmi.expression"
    },
    "schemaVersion": {
      "const": 1
    },
    "mathJson": {
      "$ref": "mathjson-profile.schema.json"
    },
    "symbolBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engineSymbol",
          "symbolId"
        ],
        "properties": {
          "engineSymbol": {
            "type": "string",
            "pattern": "^kz_[A-Za-z0-9_-]{1,80}$"
          },
          "symbolId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authoredNumbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "lexeme",
          "representation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(|/(0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*)$"
          },
          "lexeme": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$|^-?(0|[1-9][0-9]*)/[1-9][0-9]*$"
          },
          "representation": {
            "enum": [
              "exactDecimal",
              "exactRational",
              "approximate"
            ]
          },
          "numerator": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "denominator": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "precision": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "representation": {
                  "const": "exactRational"
                }
              },
              "required": [
                "representation"
              ]
            },
            "then": {
              "required": [
                "numerator",
                "denominator"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "representation": {
                  "const": "approximate"
                }
              },
              "required": [
                "representation"
              ]
            },
            "then": {
              "required": [
                "precision"
              ]
            }
          }
        ]
      }
    },
    "unitAttachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "unitId"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(|/(0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*)$"
          },
          "unitId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceMap": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "nodeId",
          "blockId"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(|/(0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*)$"
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "blockId": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latex": {
          "type": "string"
        },
        "mathLiveVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
