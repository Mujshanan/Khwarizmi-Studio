{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/schemas/v1/mathjson-profile.schema.json",
  "title": "Khwarizmi MathJSON Scalar Profile v1",
  "$defs": {
    "integerAtom": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num"
          ],
          "properties": {
            "num": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "positiveIntegerAtom": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num"
          ],
          "properties": {
            "num": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      ]
    },
    "numberObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num"
      ],
      "properties": {
        "num": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
        }
      }
    },
    "rational": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Rational"
        },
        {
          "$ref": "#/$defs/integerAtom"
        },
        {
          "$ref": "#/$defs/positiveIntegerAtom"
        }
      ],
      "items": false
    },
    "scalar": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/numberObject"
        },
        {
          "type": "string",
          "enum": [
            "Pi",
            "ExponentialE"
          ]
        },
        {
          "type": "string",
          "pattern": "^kz_[A-Za-z0-9_-]{1,80}$"
        },
        {
          "$ref": "#/$defs/rational"
        },
        {
          "$ref": "#/$defs/unary"
        },
        {
          "$ref": "#/$defs/binary"
        },
        {
          "$ref": "#/$defs/nary"
        },
        {
          "$ref": "#/$defs/log"
        }
      ]
    },
    "unary": {
      "type": "array",
      "prefixItems": [
        {
          "enum": [
            "Negate",
            "Sqrt",
            "Abs",
            "Exp",
            "Ln",
            "Lg",
            "Sin",
            "Cos",
            "Tan",
            "Arcsin",
            "Arccos",
            "Arctan"
          ]
        },
        {
          "$ref": "#/$defs/scalar"
        }
      ],
      "items": false
    },
    "binary": {
      "type": "array",
      "prefixItems": [
        {
          "enum": [
            "Subtract",
            "Divide",
            "Power"
          ]
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/scalar"
        }
      ],
      "items": false
    },
    "nary": {
      "type": "array",
      "minItems": 3,
      "prefixItems": [
        {
          "enum": [
            "Add",
            "Multiply"
          ]
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/scalar"
        }
      ],
      "items": {
        "$ref": "#/$defs/scalar"
      }
    },
    "comparison": {
      "type": "array",
      "prefixItems": [
        {
          "enum": [
            "Equal",
            "NotEqual",
            "Less",
            "LessEqual",
            "Greater",
            "GreaterEqual"
          ]
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/scalar"
        }
      ],
      "items": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "True",
            "False"
          ]
        },
        {
          "$ref": "#/$defs/comparison"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "And",
                "Or"
              ]
            },
            {
              "$ref": "#/$defs/condition"
            },
            {
              "$ref": "#/$defs/condition"
            }
          ],
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "Not"
            },
            {
              "$ref": "#/$defs/condition"
            }
          ],
          "items": false
        }
      ]
    },
    "log": {
      "type": "array",
      "oneOf": [
        {
          "prefixItems": [
            {
              "const": "Log"
            },
            {
              "$ref": "#/$defs/scalar"
            }
          ],
          "items": false
        },
        {
          "prefixItems": [
            {
              "const": "Log"
            },
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "$ref": "#/$defs/scalar"
            }
          ],
          "items": false
        }
      ]
    }
  },
  "$ref": "#/$defs/scalar",
  "$comment": "Restricted MathJSON profile. Arbitrary precision decimal atoms use the standard MathJSON {num: string} form. Semantic validation is still mandatory."
}
